# =====================================================================
# Threat Intelligence Aggregator & IOC Scanner - Environment Config
# =====================================================================

# Optional: Add your free community API keys below.
# If left blank, the application will seamlessly use high-fidelity Demo / Simulation Mode!

# VirusTotal v3 API Key (Free tier: 4 requests/min, 500 requests/day)
# Register at: https://www.virustotal.com/gui/join-us
VT_API_KEY=

# AbuseIPDB v2 API Key (Free tier: 1000 requests/day)
# Register at: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=

# AlienVault OTX API Key (Free tier: Community access)
# Register at: https://otx.alienvault.com/api
OTX_API_KEY=

# Enable default Demo/Simulation Mode out of the box (True/False)
DEFAULT_DEMO_MODE=True
